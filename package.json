{
  "name": "wafia-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "npm run build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/prepare-standalone.mjs && node scripts/run-standalone.mjs",
    "lint": "eslint src next.config.ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "check:image-fill-sizes": "node scripts/check-image-fill-sizes.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "release:check": "npm run build:standalone && npm run verify:standalone && WIKI_VERIFY_SKIP_BUILD=1 npm run wiki:verify",
    "wiki:release": "bash scripts/wiki-release.sh",
    "wiki:verify": "bash scripts/wiki-verify.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.48.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/preset-confetti": "^3.2.0",
    "@tsparticles/preset-fire": "^3.2.0",
    "@tsparticles/preset-firefly": "^3.2.0",
    "@tsparticles/preset-fireworks": "^3.2.0",
    "@tsparticles/preset-hyperspace": "^3.2.0",
    "@tsparticles/preset-links": "^3.2.0",
    "@tsparticles/preset-sea-anemone": "^3.2.0",
    "@tsparticles/preset-snow": "^3.2.0",
    "@tsparticles/preset-squares": "^3.2.0",
    "@tsparticles/preset-stars": "^3.2.0",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.25.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.4.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.3",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "knip": "^5.86.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  }
}
