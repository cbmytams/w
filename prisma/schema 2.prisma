generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  TALENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TalentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITCH
  PODCAST
  OTHER
}

enum SyncStatus {
  OK
  PENDING
  FAILED
  DISCONNECTED
}

enum MetricSource {
  OAUTH
  API_PROVIDER
  MANUAL
}

enum FileType {
  MEDIA_KIT
  CONTRACT
  CERTIFICATION
  OTHER
}

enum ContactChannel {
  EMAIL
  PHONE
  WHATSAPP
  AGENT
}

enum QuestionnaireType {
  TALENTS
  BRANDS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  talents Talent[]
  categories Category[]
  tags Tag[]
  auditLogs AuditLog[]

  @@index([name])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Talent {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  slug            String         @unique
  status          TalentStatus   @default(ACTIVE)
  approvalStatus  ApprovalStatus @default(PENDING)
  categories      String[]
  tags            String[]
  location        String?
  languages       String[]
  bioPublic       String?
  notesInternal   String?
  arppCertified   Boolean        @default(false)
  arppValidUntil  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  platformAccounts    PlatformAccount[]
  contacts            Contact[]
  rateCards           RateCard[]
  questionnaireResponses QuestionnaireResponse[]
  files               File[]

  @@index([tenantId])
  @@index([status, approvalStatus])
  @@index([categories], type: Gin)
  @@index([tags], type: Gin)
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model PlatformAccount {
  id                 String     @id @default(cuid())
  talentId           String
  platform           Platform
  handle             String
  url                String?
  verified           Boolean    @default(false)
  connectedViaOauth  Boolean    @default(false)
  lastSyncAt         DateTime?
  syncStatus         SyncStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  talent            Talent            @relation(fields: [talentId], references: [id])
  metricsSnapshots  MetricsSnapshot[]

  @@unique([platform, handle])
  @@index([talentId])
  @@index([handle])
}

model MetricsSnapshot {
  id                   String        @id @default(cuid())
  platformAccountId    String
  capturedAt           DateTime      @default(now())
  followers            Int?
  avgViews12           Int?
  engagementRate       Float?
  audienceTopCountries Json?
  audienceAge          Json?
  audienceGender       Json?
  source               MetricSource

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id])

  @@index([platformAccountId, capturedAt])
}

model Contact {
  id                     String          @id @default(cuid())
  talentId               String
  email                  String?
  phone                  String?
  agentName              String?
  agentEmail             String?
  agentPhone             String?
  preferredContactChannel ContactChannel?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  talent Talent @relation(fields: [talentId], references: [id])

  @@index([talentId])
}

model RateCard {
  id               String   @id @default(cuid())
  talentId         String
  currency         String   @default("EUR")
  priceMin         Int?
  priceMax         Int?
  priceNotes       String?
  usageRightsNotes String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  talent Talent @relation(fields: [talentId], references: [id])

  @@index([talentId])
  @@index([currency])
  @@index([priceMin, priceMax])
}

model Questionnaire {
  id          String   @id @default(cuid())
  version     String
  type        QuestionnaireType
  sectionsJson Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  responses QuestionnaireResponse[]

  @@index([version])
  @@index([type])
}

model QuestionnaireResponse {
  id              String   @id @default(cuid())
  talentId        String
  questionnaireId String
  type            QuestionnaireType
  answersJson     Json
  completionRate  Float
  score           Int?
  submittedAt     DateTime @default(now())

  talent        Talent        @relation(fields: [talentId], references: [id])
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])

  @@index([talentId])
  @@index([questionnaireId])
  @@index([type])
}

model File {
  id         String   @id @default(cuid())
  talentId   String
  type       FileType @default(OTHER)
  filename   String
  storageUrl String
  createdAt  DateTime @default(now())

  talent Talent @relation(fields: [talentId], references: [id])

  @@index([talentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String
  action    String
  entity    String
  entityId  String
  diffJson  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([actorId])
}
