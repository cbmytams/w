# =============================================================================
# Wafia website — environment variables
# Copy to `.env.local` for dev. In prod, secrets live on the VPS in `.env`.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # Public URL of the marketing site (used by metadata, sitemap, JSON-LD)
NEXT_PUBLIC_APP_URL="http://localhost:3001"           # Public URL of the platform/app (admin SPAs)
APP_URL="http://localhost:3001"                       # Server-side equivalent of NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SITE_SOCIALS=""                           # CSV of social URLs injected into Organization schema
NEXT_PUBLIC_GA_ID=""                                  # Google Analytics 4 measurement ID (G-XXXXXXXXXX)
DEFAULT_TENANT_SLUG="wafia"                           # Multi-tenant default slug

# --- Auth (NextAuth + RBAC env-credentials) ---------------------------------
NEXTAUTH_SECRET=""                                    # 32+ char random string — `openssl rand -hex 32`
NEXTAUTH_URL="http://localhost:3000"                  # NextAuth canonical URL (must match deployment origin)
ADMIN_SESSION_SECRET=""                               # Separate session secret for admin SPA cookies
ADMIN_USERNAME=""                                     # RBAC role=admin login
ADMIN_PASSWORD_HASH=""                                # bcrypt hash — `node scripts/hash-password.mjs 'plaintext'`
MANAGER_USERNAME=""                                   # RBAC role=manager login
MANAGER_PASSWORD_HASH=""                              # bcrypt hash
VIEWER_USERNAME=""                                    # RBAC role=viewer login (read-only dashboard)
VIEWER_PASSWORD_HASH=""                               # bcrypt hash
# Legacy plaintext vars (ADMIN_PASSWORD / MANAGER_PASSWORD / VIEWER_PASSWORD)
# are still accepted as a fallback during rollout. Migrate to *_PASSWORD_HASH.

# --- Database (Prisma / Postgres) -------------------------------------------
DATABASE_URL="postgresql://user:pass@localhost:5432/wafia?schema=public"

# --- Security: same-origin / proxy ------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"   # CSV of origins allowed by enforceSameOrigin (POST routes)
INTERNAL_JOB_TOKEN=""                                 # Bearer secret for /api/v1/* internal cron/job calls (timing-safe compared)
PLATFORM_PROXY_ALLOWLIST="contacts/intake"            # CSV of platform sub-paths the /api/v1/[...path] proxy is allowed to forward
PLATFORM_PROXY_MAX_BODY_BYTES=""                      # Optional integer — max bytes allowed through the proxy

# --- Contact form / webhooks ------------------------------------------------
CONTACT_WEBHOOK_URL=""                                # External webhook receiving /api/contact submissions
CONTACT_INTAKE_TOKEN=""                               # Bearer token forwarded to the webhook (preferred name)
CONTACT_WEBHOOK_TOKEN=""                              # Legacy alias, still accepted as fallback
CONTACT_TEAM_EMAIL="contact@wafia.fr"                 # Notification recipient (used by Resend integration)

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_WEBHOOK_SECRET=""

# --- Rate limiting (Upstash) ------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""                             # Public Sentry DSN (browser + edge)
SENTRY_AUTH_TOKEN=""                                  # Sentry build-time token for sourcemap upload
OTEL_EXPORTER_OTLP_ENDPOINT=""                        # Optional OpenTelemetry collector
OTEL_EXPORTER_OTLP_HEADERS=""                         # Optional OTLP auth headers

# --- IndexNow (search engine ping) ------------------------------------------
INDEXNOW_HOST="wafia.fr"
INDEXNOW_KEY=""
INDEXNOW_KEY_LOCATION=""
INDEXNOW_URLS=""

# --- Platform forwarding (legacy) -------------------------------------------
PLATFORM_PUBLIC_URL="http://localhost:3001"
PLATFORM_CONTACT_INTAKE_URL="http://localhost:3000/api/v1/contacts/intake"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
