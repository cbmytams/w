# =============================================================================
# Wafia website — environment variables
# Copy to `.env.local` for dev. In prod, secrets live on the VPS in `.env`.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # Public URL of the marketing site (used by metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_SOCIALS=""                           # CSV of social URLs injected into Organization schema
NEXT_PUBLIC_GA_ID=""                                  # Google Analytics 4 measurement ID (G-XXXXXXXXXX)

# --- Security: same-origin ---------------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000"               # CSV of origins allowed by enforceSameOrigin (POST routes)

# --- Contact form / webhooks ------------------------------------------------
CONTACT_WEBHOOK_URL=""                                # External webhook receiving /api/contact submissions
CONTACT_INTAKE_TOKEN=""                               # Bearer token forwarded to the webhook (preferred name)
CONTACT_WEBHOOK_TOKEN=""                              # Legacy alias, still accepted as fallback
CONTACT_TEAM_EMAIL="contact@wafia.fr"                 # Notification recipient (used by Resend integration)

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_WEBHOOK_SECRET=""

# --- Rate limiting (Upstash) ------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""                             # Public Sentry DSN (browser + edge)
SENTRY_AUTH_TOKEN=""                                  # Sentry build-time token for sourcemap upload
OTEL_EXPORTER_OTLP_ENDPOINT=""                        # Optional OpenTelemetry collector
OTEL_EXPORTER_OTLP_HEADERS=""                         # Optional OTLP auth headers

# --- IndexNow (search engine ping) ------------------------------------------
INDEXNOW_HOST="wafia.fr"
INDEXNOW_KEY=""
INDEXNOW_KEY_LOCATION=""
INDEXNOW_URLS=""

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
